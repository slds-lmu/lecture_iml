# Synced from lecture_service (exercises-template/); don't edit it here.

/.quarto/

# exercise-only HTML from `make exhtml` (not committed)
*_ex.html

# Re-include what the root .gitignore of lectures synced with lecture_service
# ignores (exercises/*/*.tex, exercises/*/*.pdf) but the sheets need: the LaTeX
# preamble of the template and the committed PDFs of every sheet
!_quarto/*.tex
!*/*_ex.pdf
!*/*_all.pdf
